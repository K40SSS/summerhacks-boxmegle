# EXAMPLE ENV FILE, NO REAL VARIABLES ARE TO BE PUT HERE

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ca-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ca-central-1.pooler.supabase.com:5432/postgres"

# Matchmaker server URL, used by the web app (defaults to localhost:4000 if unset)
NEXT_PUBLIC_MATCHMAKER_URL="http://localhost:4000"

# Replay tapes are uploaded to Supabase Storage; completed_games.replay_key
# holds the object key. Server-side only -- this key bypasses RLS and must
# never be exposed to the browser, which is why the web app fetches tapes
# through the matchmaker's /games/:id/replay rather than from Storage direct.
# Without it, matches are still recorded but no replay is stored.
# Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Optional. Derived from the project ref in DATABASE_URL when unset.
# SUPABASE_URL="https://<project-ref>.supabase.co"

# Optional. Bucket for replay tapes, created on first upload. Defaults to "replays".
# SUPABASE_REPLAY_BUCKET="replays"
