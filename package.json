{
  "name": "boxmegle",
  "private": true,
  "scripts": {
    "predev": "lsof -ti tcp:3000,4000 | xargs kill -9 2>/dev/null || true",
    "dev": "concurrently -n web,server -c blue,green \"pnpm dev:web\" \"pnpm dev:server\"",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
